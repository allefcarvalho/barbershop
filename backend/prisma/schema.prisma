// =============================================
// Plataforma Barbearias — Prisma Schema (multi-tenant)
// Regras que o Prisma não expressa (EXCLUDE, CHECK) estão na migration SQL.
// Todo DateTime é timestamptz (UTC no banco; fuso do tenant só na exibição/cálculo).
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MANAGER
  RECEPTIONIST
  BARBER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  PANEL
  WALK_IN
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum NotificationChannel {
  INTERNAL
  WHATSAPP
  SMS
}

enum NotificationType {
  CONFIRMATION
  REMINDER
  CANCELLATION
  WAITLIST // abriu horário para quem está na lista de espera
  MESSAGE // resposta livre (ex.: retorno ao "1"/"2" do cliente)
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // não faz mais sentido enviar (agendamento cancelado/remarcado, cliente saiu)
}

/// Uma barbearia. Configurações de agenda ficam aqui (antes eram constantes no código).
model Tenant {
  id                        String   @id @default(uuid())
  slug                      String   @unique
  name                      String
  timezone                  String   @default("America/Sao_Paulo")
  slotStepMinutes           Int      @default(15) @map("slot_step_minutes")
  minAdvanceMinutes         Int      @default(60) @map("min_advance_minutes")
  maxAdvanceDays            Int      @default(30) @map("max_advance_days")
  clientCancelMinHours      Int      @default(2) @map("client_cancel_min_hours")
  recurringThreshold        Int      @default(3) @map("recurring_threshold")
  maxActiveBookingsPerPhone Int      @default(2) @map("max_active_bookings_per_phone")
  /// true = agendamento online nasce PENDING e a equipe confirma (RN04)
  requireConfirmation       Boolean  @default(false) @map("require_confirmation")
  /// Lembrete automático X horas antes (0 = desligado)
  reminderHours             Int      @default(24) @map("reminder_hours")
  /// Faltas (6 meses) a partir das quais o agendamento online fica pendente de confirmação (0 = desligado)
  noShowLimit               Int      @default(0) @map("no_show_limit")
  /// Número da barbearia na WhatsApp Cloud API (o token fica no servidor, nunca no banco)
  whatsappPhoneNumberId     String?  @unique @map("whatsapp_phone_number_id")
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships   Membership[]
  clients       Client[]
  services      Service[]
  bookings      Booking[]
  products      Product[]
  orders        Order[]
  registers     CashRegister[]
  notifications Notification[]
  waitlist      WaitlistEntry[]

  @@map("tenants")
}

/// Pessoa que faz login. Papel e dados profissionais ficam na Membership (por barbearia).
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  avatarUrl    String?  @map("avatar_url")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Vínculo usuário ↔ barbearia. Barbeiro = membership que atende serviços.
model Membership {
  id                   String     @id @default(uuid())
  tenantId             String     @map("tenant_id")
  userId               String     @map("user_id")
  role                 MemberRole @default(BARBER)
  active               Boolean    @default(true)
  /// Comissão em % sobre o valor pago (já com desconto) de serviços e de produtos vendidos
  serviceCommissionPct Int        @default(0) @map("service_commission_pct")
  productCommissionPct Int        @default(0) @map("product_commission_pct")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               BarberService[]
  availabilities         Availability[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]
  stockMovements         StockMovement[]
  refreshTokens          RefreshToken[]
  orders                 Order[]
  registersOpened        CashRegister[]

  @@unique([tenantId, userId])
  @@map("memberships")
}

/// Refresh token rotativo. Guardamos só o hash; reuso de um token já trocado revoga a família.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  membershipId String    @map("membership_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model Client {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  name             String
  phone            String // E.164, ex.: +5511999990000
  email            String?
  totalBookings    Int       @default(0) @map("total_bookings")
  lastVisit        DateTime? @map("last_visit") @db.Timestamptz(3)
  isRecurring      Boolean   @default(false) @map("is_recurring")
  notes            String? // preferências (ex.: "máquina 2 nas laterais")
  /// LGPD: quando aceitou a política de privacidade / mensagens
  consentAt        DateTime? @map("consent_at") @db.Timestamptz(3)
  /// Respondeu "SAIR" no WhatsApp: não recebe mais mensagens
  whatsappOptOutAt DateTime? @map("whatsapp_opt_out_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  orders        Order[]
  notifications Notification[]
  waitlist      WaitlistEntry[]

  @@unique([tenantId, phone])
  @@map("clients")
}

model Service {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  name            String
  description     String
  priceCents      Int     @map("price_cents")
  durationMinutes Int     @map("duration_minutes")
  active          Boolean @default(true)
  imageUrl        String? @map("image_url")
  sortOrder       Int     @default(0) @map("sort_order")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barbers    BarberService[]
  bookings   Booking[]
  orderItems OrderItem[]

  waitlist WaitlistEntry[]

  @@index([tenantId, sortOrder])
  @@map("services")
}

model BarberService {
  id           String @id @default(uuid())
  membershipId String @map("membership_id")
  serviceId    String @map("service_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([membershipId, serviceId])
  @@map("barber_services")
}

model Availability {
  id           String  @id @default(uuid())
  membershipId String  @map("membership_id")
  dayOfWeek    Int     @map("day_of_week") // 0 = domingo … 6 = sábado
  startTime    String  @map("start_time") // "09:00" no fuso do tenant
  endTime      String  @map("end_time")
  active       Boolean @default(true)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, dayOfWeek])
  @@map("availabilities")
}

model AvailabilityException {
  id           String   @id @default(uuid())
  membershipId String   @map("membership_id")
  date         DateTime @db.Date
  isBlocked    Boolean  @default(true) @map("is_blocked")
  startTime    String?  @map("start_time")
  endTime      String?  @map("end_time")
  reason       String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, date])
  @@map("availability_exceptions")
}

model Booking {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  clientId        String        @map("client_id")
  barberId        String        @map("barber_id") // membership
  serviceId       String        @map("service_id")
  startAt         DateTime      @map("start_at") @db.Timestamptz(3)
  endAt           DateTime      @map("end_at") @db.Timestamptz(3)
  status          BookingStatus @default(CONFIRMED)
  /// Preço e duração no momento da reserva (mudar o serviço não altera o histórico)
  priceCents      Int           @map("price_cents")
  durationMinutes Int           @map("duration_minutes")
  notes           String?
  source          BookingSource @default(ONLINE)
  /// Hash do token do link "gerenciar agendamento" enviado ao cliente (o token em si nunca é salvo)
  manageTokenHash String?       @unique @map("manage_token_hash")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id])
  barber        Membership     @relation(fields: [barberId], references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  notifications Notification[]
  order         Order?

  @@index([barberId, startAt])
  @@index([tenantId, startAt])
  @@index([clientId, createdAt])
  @@map("bookings")
}

model Product {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String
  priceCents    Int      @map("price_cents")
  stockQuantity Int      @default(0) @map("stock_quantity")
  stockMin      Int      @default(5) @map("stock_min")
  imageUrl      String?  @map("image_url")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@index([tenantId])
  @@map("products")
}

model StockMovement {
  id           String            @id @default(uuid())
  productId    String            @map("product_id")
  membershipId String            @map("membership_id")
  type         StockMovementType
  quantity     Int
  reason       String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product    Product    @relation(fields: [productId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([productId, createdAt])
  @@map("stock_movements")
}

/// Fila de mensagens (o worker envia). Agendada por scheduledFor; retentativa com espera crescente.
model Notification {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  clientId     String              @map("client_id")
  bookingId    String?             @map("booking_id")
  channel      NotificationChannel @default(INTERNAL)
  type         NotificationType
  status       NotificationStatus  @default(PENDING)
  /// Dados extras da mensagem (ex.: link do cliente até ser enviado, texto de resposta)
  payload      Json?
  scheduledFor DateTime            @default(now()) @map("scheduled_for") @db.Timestamptz(3)
  attempts     Int                 @default(0)
  lastError    String?             @map("last_error")
  /// ID da mensagem no WhatsApp (para o webhook atualizar entregue/lida/falhou)
  externalId   String?             @unique @map("external_id")
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

/// Lista de espera: cliente quer um horário num dia sem vaga; é avisado se alguém cancelar.
model WaitlistEntry {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  clientId   String    @map("client_id")
  serviceId  String    @map("service_id")
  barberId   String?   @map("barber_id") // null = qualquer profissional
  date       DateTime  @db.Date
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([clientId, serviceId, date])
  @@index([tenantId, date])
  @@map("waitlist_entries")
}

// =============================================
// Fase 2 — Comanda, caixa e comissões
// =============================================

enum PaymentMethod {
  PIX
  CREDIT
  DEBIT
  CASH
}

enum OrderStatus {
  PAID
  VOIDED
}

enum OrderItemKind {
  SERVICE
  PRODUCT
}

enum CashMovementType {
  DEPOSIT // suprimento (entrou dinheiro no caixa sem venda, ex.: troco)
  WITHDRAWAL // sangria (saiu dinheiro do caixa)
}

/// Comanda: o que foi feito/vendido e como foi pago. Depois de fechada não muda;
/// correção = estorno (status VOIDED) + nova comanda (RN18).
model Order {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  registerId    String      @map("register_id")
  bookingId     String?     @unique @map("booking_id")
  clientId      String?     @map("client_id")
  barberId      String?     @map("barber_id") // profissional que atendeu (comissão e gorjeta)
  subtotalCents Int         @map("subtotal_cents")
  discountCents Int         @default(0) @map("discount_cents")
  tipCents      Int         @default(0) @map("tip_cents")
  totalCents    Int         @map("total_cents") // subtotal - desconto + gorjeta = soma dos pagamentos
  status        OrderStatus @default(PAID)
  createdById   String      @map("created_by_id")
  voidReason    String?     @map("void_reason")
  voidedById    String?     @map("voided_by_id")
  voidedAt      DateTime?   @map("voided_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register CashRegister @relation(fields: [registerId], references: [id])
  booking  Booking?     @relation(fields: [bookingId], references: [id])
  client   Client?      @relation(fields: [clientId], references: [id])
  barber   Membership?  @relation(fields: [barberId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([tenantId, createdAt])
  @@index([registerId])
  @@index([barberId, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  kind             OrderItemKind
  serviceId        String?       @map("service_id")
  productId        String?       @map("product_id")
  description      String
  quantity         Int
  unitPriceCents   Int           @map("unit_price_cents")
  /// Valor da linha já com a parte proporcional do desconto (base da comissão, RN19)
  totalCents       Int           @map("total_cents")
  commissionCents  Int           @default(0) @map("commission_cents")
  commissionPaidAt DateTime?     @map("commission_paid_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @map("order_id")
  method      PaymentMethod
  amountCents Int           @map("amount_cents")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

/// Caixa do dia. Só um aberto por barbearia (índice parcial na migration).
model CashRegister {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  openedById       String    @map("opened_by_id")
  openingCents     Int       @map("opening_cents")
  openedAt         DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedById       String?   @map("closed_by_id")
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  /// Dinheiro contado no fechamento; a diferença para o esperado aparece no relatório
  countedCashCents Int?      @map("counted_cash_cents")
  notes            String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy  Membership     @relation(fields: [openedById], references: [id])
  orders    Order[]
  movements CashMovement[]

  @@index([tenantId, openedAt])
  @@map("cash_registers")
}

model CashMovement {
  id           String           @id @default(uuid())
  registerId   String           @map("register_id")
  membershipId String           @map("membership_id")
  type         CashMovementType
  amountCents  Int              @map("amount_cents")
  reason       String
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@map("cash_movements")
}

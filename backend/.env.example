# Copie para backend/.env
DATABASE_URL="postgresql://vikinges:vikinges_secret@localhost:5433/barbearia_vikinges?schema=public"
PORT=3333
NODE_ENV=development

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_32_chars_random_secret_xxxxxxxx
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

CORS_ORIGIN=http://localhost:5173

# Opcional: com REDIS_URL o rate limit fica compartilhado entre instâncias
# REDIS_URL=redis://localhost:6379

# Endereço do site (usado nos links enviados ao cliente)
PUBLIC_APP_URL=http://localhost:5173

# WhatsApp Cloud API (Meta). Sem WHATSAPP_TOKEN as mensagens vão só para o log.
# WHATSAPP_TOKEN=token-permanente-do-usuario-do-sistema
# WHATSAPP_APP_SECRET=segredo-do-app-meta
# WHATSAPP_VERIFY_TOKEN=frase-que-voce-escolhe-para-o-webhook
